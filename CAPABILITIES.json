    "subtitles": {
      "status": "bounded",
      "merge_policy": "complement",
      "discovery": "<basename>(.<lang>)?.{srt,vtt,ass,ssa} next to primary video",
      "language_token_policy": "ISO 639 conservative — 2-3 letter primary subtag, optional 2-4 alphanumeric region subtag (e.g. en, eng, en-US, pt-BR, zh-Hans). Anything else is treated as a non-language stem suffix.",
      "supported_tags": [
        "subtitles.<i>.format",
        "subtitles.<i>.language",
        "subtitles.<i>.cue_count",
        "subtitles.<i>.duration_seconds",
        "subtitles.<i>.path",
        "subtitles.<i>.first_cue_text",
        "subtitles.<i>.style_count (ASS/SSA only)"
      ]
    },
    "gopro": {
      "status": "bounded",
      "merge_policy": "complement",
      "discovery": "GH/GX -> GL prefix shift for LRV; same-prefix <stem>.THM for thumbnail; generic <stem>.LRV / <stem>.THM fallback",
      "supported_tags": [
        "proxy.path",
        "proxy.size_bytes",
        "proxy.format",
        "proxy.codec",
        "proxy.dimensions.width",
        "proxy.dimensions.height",
        "proxy.bitrate_bps",
        "thumbnail.path",
        "thumbnail.size_bytes",
        "thumbnail.format",
        "thumbnail.dimensions.width",
        "thumbnail.dimensions.height"
      ]
    },
    "mediapro": {
      "status": "bounded",
      "merge_policy": "complement",
      "schema_versions": [
        "http://xmlns.sony.net/pro/metadata/mediaprofile"
      ],
      "discovery": "MEDIAPRO.XML in any parent directory up to 4 hops above primary (case-insensitive)",
      "supported_tags": [
        "media_profile.version",
        "media_profile.created_at",
        "media_profile.system_id",
        "media_profile.system_kind",
        "media_profile.master_version",
        "media_profile.media_id",
        "media_profile.media_kind",
        "media_profile.media_name",
        "media_profile.recording_session.start",
        "media_profile.recording_session.end",
        "media_profile.clip_count",
        "media_profile.cross_refs.<i>.kind",
        "media_profile.cross_refs.<i>.umid",
        "mediapro.umid",
        "mediapro.video_type",
        "mediapro.audio_type",
        "mediapro.fps",
        "mediapro.duration_frames",
        "mediapro.channels",
        "mediapro.aspect_ratio",
        "mediapro.thumbnail.path"
      ],
      "notes": "Sony XAVC card-level index (PRIVATE/M4ROOT/MEDIAPRO.XML). Walks parents up to 4 hops to locate the index, encodes the present clip's basename in SidecarRef.label, and matches the present clip by basename suffix on Material@uri. Header fields (media_profile.*) emit unconditionally; per-clip mediapro.* entries emit only on a match. Pro-cam-only fields (recording_session.*, cross_refs.*) are absent on consumer-cam fixtures. Orphan thumbnail targets surface as info-severity sidecar_target_missing issues, never panics."
    },
    "c2pa_sidecar": {
      "status": "bounded",
      "merge_policy": "complement",
      "discovery": "<basename>.c2pa next to primary asset (case-insensitive extension)",
      "supported_tags": [
        "c2pa.claim_generator",
        "c2pa.format",
        "c2pa.instance_id",
        "c2pa.signature.alg",
        "c2pa.signature.issuer",
        "c2pa.signature.verified",
        "c2pa.assertions.<i>.label",
        "c2pa.assertions.<i>.action",
        "c2pa.assertions.<i>.description",
        "c2pa.assertions.<i>.digitalSourceType",
        "c2pa.assertions.<i>.softwareAgent",
        "c2pa.assertions.<i>.when",
        "c2pa.ingredients.<i>.title",
        "c2pa.ingredients.<i>.format",
        "c2pa.ingredients.<i>.relationship",
        "c2pa.ai_generated"
      ],
      "notes": "External JUMBF manifest sibling. Routes raw bytes through `xifty-meta-c2pa::decode_jumbf` and re-namespaces `c2pa.*` entries to `c2pa_sidecar`. Cross-cutting `ai.*` entries keep the bare `ai` namespace."
    },
    "classic_thm": {
      "status": "bounded",
      "merge_policy": "complement",
      "priority": 50,
      "discovery": "same-stem .THM (case-insensitive) next to .mov/.avi/.mp4/.mts; skips GoPro GH/GX-prefix stems (matches gopro_lrv_stem)",
      "supported_tags": [
        "thumbnail.path",
        "thumbnail.size_bytes",
        "thumbnail.format",
        "thumbnail.dimensions.width",
        "thumbnail.dimensions.height",
        "thumbnail.exif.make",
        "thumbnail.exif.model",
        "thumbnail.exif.captured_at"
      ],
      "notes": "Sidecar crate emits raw `thumbnail.exif_payload` (TypedValue::Bytes) when the .THM carries APP1 EXIF; the CLI dispatches that payload through the existing TIFF + EXIF decode chain and projects the flat `thumbnail.exif.{make,model,captured_at}` fields into namespace `classic_thm`. The raw payload entry is dropped before normalization. Priority 50 is sort-order only; the GH/GX-prefix stem-skip in discovery is the SOLE collision-avoidance mechanism with the GoPro adapter (`MergePolicy::Complement` does no deduplication). GP-prefix stems are claimed by classic_thm so they are not orphaned."
    }
